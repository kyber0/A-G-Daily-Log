# A&G App — local development environment variables
# Copy this file to .env and fill in your values for dev mode.
# Note: For production packaged builds, credentials are configured via the First Launch
# or Settings screen and stored locally in config.json.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# Google Drive Cloud Backups (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
