{
  "name": "ag-daily-log",
  "version": "2.1.0",
  "description": "A&G Water Refill Daily Log App",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder",
    "release": "electron-vite build && electron-builder --publish always",
    "preview": "electron-vite preview",
    "convert-icon": "node scripts/convert-icon.mjs",
    "migrate": "tsx scripts/migrate/index.ts",
    "validate": "tsx scripts/migrate/05_validate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Keaneth Dave Berido",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "has-symbols": "1.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^3.4.0",
    "flatpickr": "^4.6.13",
    "googleapis": "^176.0.0"
  },
  "build": {
    "appId": "com.ag.dailylog",
    "productName": "A&G Daily Log",
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "kyber0",
        "repo": "A-G-Daily-Log"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "dist-app"
    }
  }
}
